{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "snapshot": false,
  "plugin": ["file:///usr/local/lib/node_modules/oh-my-opencode-slim"],
  "instructions": ["/home/node/CLAUDE.md"],
  "skills": {
    "paths": ["/home/node/.claude/skills"]
  },
  "permission": {
    "edit": "deny",
    "external_directory": "allow",
    "bash": {
      "*": "allow",
      "company-image *": "allow",
      "slack-thread-artifact *": "allow",
      "gh *": "deny",
      "git clone*": "deny",
      "git fetch*": "deny",
      "git pull*": "deny",
      "git push*": "deny",
      "git commit*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git worktree*": "deny",
      "codegraph init*": "deny",
      "codegraph index*": "deny",
      "codegraph sync*": "deny",
      "codegraph uninit*": "deny",
      "codegraph daemon*": "deny"
    }
  },
  "provider": {
    "company": {
      "npm": "@ai-sdk/openai",
      "name": "Company Gateway",
      "options": {
        "baseURL": "{env:COMPANY_GATEWAY_BASE_URL}",
        "apiKey": "{env:COMPANY_GATEWAY_API_KEY}"
      },
      "models": {
        "gpt-6-astra": {
          "name": "Astra (orchestration)",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 1050000, "output": 128000 }
        },
        "gpt-5.6-terra": {
          "name": "Terra (synthesis)",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 272000, "output": 128000 }
        },
        "gpt-5.6-luna": {
          "name": "Luna (retrieval)",
          "reasoning": true,
          "tool_call": true,
          "attachment": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 272000, "output": 128000 }
        }
      }
    }
  },
  "model": "company/gpt-6-astra",
  "small_model": "company/gpt-5.6-luna",
  "agent": {
    "explore": { "disable": true },
    "general": { "disable": true }
  }
}
