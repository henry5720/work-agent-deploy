{
  "$schema": "https://unpkg.com/oh-my-opencode-slim@2.2.15/oh-my-opencode-slim.schema.json",
  "autoUpdate": false,
  "preset": "company",
  "presets": {
    "company": {
      "orchestrator": {
        "model": "company/gpt-5.6-terra",
        "variant": "high",
        "skills": ["*"],
        "mcps": ["*"]
      },
      "oracle": {
        "model": "company/gpt-5.6-terra",
        "variant": "high",
        "skills": ["*"],
        "mcps": ["*"]
      },
      "explorer": {
        "model": "company/gpt-5.6-luna",
        "variant": "low",
        "skills": ["*"],
        "mcps": ["*"]
      },
      "librarian": {
        "model": "company/gpt-5.6-luna",
        "variant": "low",
        "skills": ["*"],
        "mcps": ["*"]
      },
      "designer": {
        "model": "company/gpt-5.6-luna",
        "variant": "medium",
        "skills": ["*"],
        "mcps": ["*"]
      },
      "fixer": {
        "model": "company/gpt-5.6-luna",
        "variant": "high",
        "skills": ["*"],
        "mcps": ["*"]
      }
    }
  },
  "acpAgents": {
    "claude-code": {
      "command": "/usr/local/bin/claude-agent-acp",
      "args": [],
      "description": "Claude Code specialist；Slack 訊息以 `delegate claude-code:` 開頭時必須委派。",
      "orchestratorPrompt": "@claude-code\n- Role: Claude Code specialist。\n- Deterministic Slack trigger: when the incoming user message starts exactly with `delegate claude-code:`, strip that prefix and delegate the complete remaining task to @claude-code immediately. Do not answer with the local agent, use local tools first, or silently reroute the task. If delegation cannot run, report the delegation failure.\n- Messages without that exact prefix keep normal OMO automatic routing.",
      "wrapperModel": "company/gpt-5.6-luna",
      "timeoutMs": 0
    }
  },
  "image_routing": "direct",
  "companion": { "enabled": false },
  "multiplexer": { "type": "none" },
  "interview": { "autoOpenBrowser": false }
}
