#!/usr/bin/env python3
"""下載並解析 agent 可讀的文件，或安全列出 ZIP archive entries。"""

from __future__ import annotations

import argparse
import contextlib
import io
import ipaddress
import multiprocessing
import os
import re
import stat
import subprocess
import sys
import tempfile
import time
import zipfile
import xml.etree.ElementTree as ET
from pathlib import Path
from pathlib import PurePosixPath
from urllib.parse import unquote, urlsplit


MAX_DOWNLOAD_BYTES = 50 * 1024 * 1024
MAX_ZIP_MEMBERS = 1000
MAX_ZIP_ENTRY_BYTES = 10 * 1024 * 1024
MAX_ZIP_TOTAL_BYTES = 100 * 1024 * 1024
MAX_DOC_OUTPUT_BYTES = 10 * 1024 * 1024
MAX_DOC_PAGES = 200
PDF_SIGNATURE = re.compile(rb"%PDF-[0-9]+\.[0-9]+")
CURL_CONNECT_TIMEOUT_SECONDS = 10
CURL_TOTAL_TIMEOUT_SECONDS = 120
DOCLING_TIMEOUT_SECONDS = 120
DOCLING_ARTIFACTS_PATH = "DOCLING_ARTIFACTS_PATH"
PARSE_DOCUMENT_ALLOWED_HOST = "PARSE_DOCUMENT_ALLOWED_HOST"
R2_PATH_STYLE_HOST = "99de68928da234ebcf0c9370443ad7ee.r2.cloudflarestorage.com"
SUPPORTED_EXTENSIONS = frozenset({".pdf", ".docx", ".xlsx", ".pptx"})
OOXML_EXTENSIONS = frozenset({".docx", ".xlsx", ".pptx"})
OOXML_REQUIRED_PARTS = {
    ".docx": (
        "word/document.xml",
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document.main+xml",
        "{http://schemas.openxmlformats.org/wordprocessingml/2006/main}document",
    ),
    ".xlsx": (
        "xl/workbook.xml",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml",
        "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}workbook",
    ),
    ".pptx": (
        "ppt/presentation.xml",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation.main+xml",
        "{http://schemas.openxmlformats.org/presentationml/2006/main}presentation",
    ),
}
OOXML_CONTENT_TYPES_NAMESPACE = "http://schemas.openxmlformats.org/package/2006/content-types"

EXIT_INVALID_INPUT = 2
EXIT_RUNTIME = 3


class ParseDocumentError(Exception):
    """不含輸入 URL 或其他可能洩漏內容的安全錯誤。"""


def extension_for_filename(filename: str) -> str:
    """回傳副檔名；filename 只作為類型提示，不會被當成路徑使用。"""
    if not filename or any(ord(char) < 0x20 for char in filename):
        raise ParseDocumentError("filename is invalid")
    if "/" in filename or "\\" in filename:
        raise ParseDocumentError("filename must be a basename")
    extension = os.path.splitext(filename)[1].lower()
    if extension not in SUPPORTED_EXTENSIONS and extension != ".zip":
        raise ParseDocumentError("unsupported file format")
    return extension


def filename_from_url(url: str) -> str:
    path = urlsplit(url).path
    basename = unquote(path.rsplit("/", 1)[-1])
    return basename or "download"


def _is_disallowed_hostname(hostname: str) -> bool:
    """拒絕 literal IP 與常見的本機／內網名稱。"""
    try:
        ipaddress.ip_address(hostname)
    except ValueError:
        pass
    else:
        return True

    normalized = hostname.rstrip(".").lower()
    if normalized == "localhost" or normalized.endswith(
        (".localhost", ".local", ".internal", ".intranet")
    ):
        return True
    # curl accepts a decimal IPv4 address as a hostname on some platforms.
    return normalized.isdigit() and int(normalized) <= 0xFFFFFFFF


def validate_url(url: str) -> None:
    allowed_host = os.environ.get(PARSE_DOCUMENT_ALLOWED_HOST)
    if not allowed_host:
        raise ParseDocumentError("PARSE_DOCUMENT_ALLOWED_HOST is not configured")
    try:
        parsed = urlsplit(url)
        hostname = parsed.hostname
        port = parsed.port
    except ValueError as exc:
        raise ParseDocumentError("invalid presigned URL") from exc
    if parsed.scheme != "https" or not parsed.netloc:
        raise ParseDocumentError("presigned URL must use HTTPS")
    if parsed.username is not None or parsed.password is not None:
        raise ParseDocumentError("presigned URL must not include userinfo")
    if port is not None:
        raise ParseDocumentError("presigned URL must not include a port")
    if hostname is None or hostname != allowed_host:
        raise ParseDocumentError("presigned URL host is not allowed")
    if _is_disallowed_hostname(hostname):
        raise ParseDocumentError("presigned URL host is not allowed")


def _download_with_curl(url: str, destination: str) -> None:
    """用 curl 串流到檔案，避免 chunked response 繞過大小限制。"""
    command = [
        "curl",
        "--fail",
        "--silent",
        "--show-error",
        "--proto",
        "=https",
        "--connect-timeout",
        str(CURL_CONNECT_TIMEOUT_SECONDS),
        "--max-time",
        str(CURL_TOTAL_TIMEOUT_SECONDS),
        "--max-filesize",
        str(MAX_DOWNLOAD_BYTES),
        url,
    ]
    try:
        process = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
        )
    except OSError as exc:
        raise ParseDocumentError("download failed") from exc

    assert process.stdout is not None
    bytes_written = 0
    too_large = False
    try:
        with open(destination, "wb") as output:
            while True:
                chunk = process.stdout.read(64 * 1024)
                if not chunk:
                    break
                if bytes_written + len(chunk) > MAX_DOWNLOAD_BYTES:
                    too_large = True
                    process.kill()
                    break
                output.write(chunk)
                bytes_written += len(chunk)
    finally:
        process.stdout.close()
        return_code = process.wait()

    if too_large or bytes_written > MAX_DOWNLOAD_BYTES:
        raise ParseDocumentError("download exceeds 50 MiB")
    if return_code != 0:
        raise ParseDocumentError("download failed")


def _is_unsafe_member_name(name: str) -> bool:
    if not name or "\x00" in name or "\n" in name or "\r" in name:
        return True
    normalized = name.replace("\\", "/")
    if normalized.startswith("/") or normalized.startswith("//"):
        return True
    if re.match(r"^[A-Za-z]:", normalized):
        return True
    return any(part == ".." for part in PurePosixPath(normalized).parts)


def validate_zip_infos(infos: list[zipfile.ZipInfo]) -> None:
    """只檢查 ZIP metadata，不讀取或解壓任何 member。"""
    if len(infos) > MAX_ZIP_MEMBERS:
        raise ParseDocumentError("ZIP contains too many entries")

    total_size = 0
    seen_names: set[str] = set()
    for info in infos:
        if _is_unsafe_member_name(info.filename):
            raise ParseDocumentError("ZIP contains an unsafe path")
        if info.filename in seen_names:
            raise ParseDocumentError("ZIP contains duplicate entries")
        seen_names.add(info.filename)
        if info.flag_bits & 0x1:
            raise ParseDocumentError("encrypted ZIP archives are not supported")
        unix_mode = (info.external_attr >> 16) & 0xFFFF
        if stat.S_ISLNK(unix_mode):
            raise ParseDocumentError("ZIP symlinks are not supported")
        if info.file_size < 0 or info.file_size > MAX_ZIP_ENTRY_BYTES:
            raise ParseDocumentError("ZIP entry exceeds 10 MiB")
        total_size += info.file_size
        if total_size > MAX_ZIP_TOTAL_BYTES:
            raise ParseDocumentError("ZIP contents exceed 100 MiB")


def list_zip_entries(path: str) -> str:
    """回傳 archive 的 Markdown 清單；不 extract、不讀取 member 內容。"""
    try:
        with zipfile.ZipFile(path) as archive:
            infos = archive.infolist()
            validate_zip_infos(infos)
    except (OSError, zipfile.BadZipFile, zipfile.LargeZipFile) as exc:
        raise ParseDocumentError("invalid ZIP archive") from exc

    lines = ["# ZIP archive entries\n", "\n"]
    output_bytes = sum(len(line.encode("utf-8")) for line in lines)
    for info in infos:
        prefix = f"- `"
        suffix = f"` ({info.file_size} bytes)\n"
        line_bytes = output_bytes + len(prefix.encode("utf-8"))
        display_parts: list[str] = []
        for char in info.filename.replace("\\", "/"):
            rendered = (
                f"\\x{ord(char):02x}"
                if ord(char) < 0x20
                else "\\`"
                if char == "`"
                else char
            )
            try:
                line_bytes += len(rendered.encode("utf-8"))
            except UnicodeError as exc:
                raise ParseDocumentError("invalid ZIP archive") from exc
            if line_bytes > MAX_DOC_OUTPUT_BYTES:
                raise ParseDocumentError("ZIP listing exceeds 10 MiB")
            display_parts.append(rendered)
        line = prefix + "".join(display_parts) + suffix
        output_bytes = line_bytes + len(suffix.encode("utf-8"))
        if output_bytes > MAX_DOC_OUTPUT_BYTES:
            raise ParseDocumentError("ZIP listing exceeds 10 MiB")
        lines.append(line)
    return "".join(lines)


def validate_ooxml_archive(path: str, extension: str) -> None:
    """在 OOXML 交給 Docling 前檢查 ZIP metadata 與最小 OOXML 結構。"""
    try:
        with zipfile.ZipFile(path) as archive:
            infos = archive.infolist()
            validate_zip_infos(infos)
            info_by_name = {info.filename: info for info in infos}
            required_part, required_content_type, required_root = OOXML_REQUIRED_PARTS[extension]
            content_types_info = info_by_name.get("[Content_Types].xml")
            required_info = info_by_name.get(required_part)
            if content_types_info is None or required_info is None:
                raise ParseDocumentError("document content does not match filename")

            content_types = archive.read(content_types_info)
            ET_root = ET.fromstring(content_types)
            if ET_root.tag != f"{{{OOXML_CONTENT_TYPES_NAMESPACE}}}Types":
                raise ParseDocumentError("document content does not match filename")
            overrides = {
                element.attrib.get("PartName"): element.attrib.get("ContentType")
                for element in ET_root
                if element.tag == f"{{{OOXML_CONTENT_TYPES_NAMESPACE}}}Override"
            }
            if overrides.get(f"/{required_part}") != required_content_type:
                raise ParseDocumentError("document content does not match filename")
            if ET.fromstring(archive.read(required_info)).tag != required_root:
                raise ParseDocumentError("document content does not match filename")
    except ParseDocumentError:
        raise
    except (
        EOFError,
        KeyError,
        OSError,
        RuntimeError,
        ValueError,
        ET.ParseError,
        zipfile.BadZipFile,
        zipfile.LargeZipFile,
    ) as exc:
        raise ParseDocumentError("document content does not match filename") from exc


def validate_document_content(path: str, extension: str) -> None:
    """確認實際檔案格式符合宣告副檔名，不能只靠檔名選 backend。"""
    try:
        with open(path, "rb") as document:
            signature = document.read(32)
        if extension == ".pdf":
            if PDF_SIGNATURE.match(signature) is None or zipfile.is_zipfile(path):
                raise ParseDocumentError("document content does not match filename")
        elif extension in OOXML_EXTENSIONS:
            validate_ooxml_archive(path, extension)
        else:
            raise ParseDocumentError("unsupported file format")
    except ParseDocumentError:
        raise
    except (OSError, ValueError, zipfile.BadZipFile, zipfile.LargeZipFile) as exc:
        raise ParseDocumentError("document content does not match filename") from exc


def _pdf_converter():
    """建立只使用 image 內預取 artifacts 的 PDF converter。"""
    configured_path = os.environ.get(DOCLING_ARTIFACTS_PATH)
    if not configured_path:
        raise ParseDocumentError("DOCLING_ARTIFACTS_PATH is not configured")
    artifacts_path = Path(configured_path)
    if not artifacts_path.is_dir() or not os.access(artifacts_path, os.R_OK | os.X_OK):
        raise ParseDocumentError("Docling artifacts directory is unavailable")

    from docling.datamodel.base_models import InputFormat
    from docling.datamodel.pipeline_options import PdfPipelineOptions
    from docling.document_converter import DocumentConverter, PdfFormatOption

    pipeline_options = PdfPipelineOptions(artifacts_path=artifacts_path)
    return DocumentConverter(
        format_options={
            InputFormat.PDF: PdfFormatOption(pipeline_options=pipeline_options),
        }
    )


def _convert_with_docling(path: str, extension: str) -> str:
    """執行一次 Docling conversion；只傳 local path，不傳 presigned URL。"""
    try:
        validate_document_content(path, extension)
        if extension == ".pdf":
            converter = _pdf_converter()
        else:
            from docling.document_converter import DocumentConverter

            # Office 格式使用 Docling Office backend，不需要 PDF pipeline artifacts
            # 或 PDF model download。
            converter = DocumentConverter()

        result = converter.convert(
            path,
            max_file_size=MAX_DOWNLOAD_BYTES,
            max_num_pages=MAX_DOC_PAGES,
        )
        return result.document.export_to_markdown()
    except ParseDocumentError:
        raise
    except Exception as exc:  # Docling exceptions vary by document/backend.
        raise ParseDocumentError("document parsing failed") from exc


def _validate_markdown_output(markdown: str) -> str:
    if not isinstance(markdown, str):
        raise ParseDocumentError("document parsing failed")
    if len(markdown.encode("utf-8")) > MAX_DOC_OUTPUT_BYTES:
        raise ParseDocumentError("parsed output exceeds 10 MiB")
    return markdown


def _docling_worker(connection, path: str, extension: str) -> None:
    """在可終止的 process 中執行 Docling，隔離其輸出與例外內容。"""
    try:
        # Docling and its dependencies may write progress or exception details.
        # Neither stream may contain input-derived data.
        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
            markdown = _validate_markdown_output(_convert_with_docling(path, extension))
        connection.send(("ok", markdown))
    except ParseDocumentError as exc:
        connection.send(("error", str(exc)))
    except BaseException:
        connection.send(("error", "document parsing failed"))
    finally:
        connection.close()


def parse_with_docling(path: str, extension: str) -> str:
    """把已下載的 local file 交給 Docling，並以 process 強制限制 120 秒。"""
    try:
        try:
            context = multiprocessing.get_context("fork")
        except ValueError:  # pragma: no cover - Linux production path uses fork.
            context = multiprocessing.get_context("spawn")
        receiver, sender = context.Pipe(duplex=False)
        process = context.Process(target=_docling_worker, args=(sender, path, extension))
        process.start()
        sender.close()
    except (OSError, RuntimeError) as exc:
        raise ParseDocumentError("document parsing failed") from exc

    deadline = time.monotonic() + DOCLING_TIMEOUT_SECONDS
    try:
        if not receiver.poll(DOCLING_TIMEOUT_SECONDS):
            process.terminate()
            process.join(0.2)
            if process.is_alive():
                process.kill()
                process.join()
            raise ParseDocumentError("document parsing timed out")

        status, payload = receiver.recv()
        remaining = max(0.0, deadline - time.monotonic())
        process.join(remaining)
        if process.is_alive():
            process.terminate()
            process.join(0.2)
            if process.is_alive():
                process.kill()
                process.join()
        if status == "error":
            raise ParseDocumentError(payload)
        if status != "ok":
            raise ParseDocumentError("document parsing failed")
        return payload
    except (EOFError, OSError) as exc:
        raise ParseDocumentError("document parsing failed") from exc
    finally:
        receiver.close()
        if process.is_alive():
            process.terminate()
            process.join(0.2)
            if process.is_alive():
                process.kill()
                process.join()


class _SafeArgumentParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        # argparse's default error includes unrecognised argument values.
        raise ParseDocumentError("invalid arguments")


def parse_args(argv: list[str]) -> tuple[str, str]:
    parser = _SafeArgumentParser(
        prog="parse-document",
        description="下載並解析 PDF/DOCX/XLSX/PPTX，或安全列出 ZIP entries。",
    )
    parser.add_argument("url", help="HTTPS presigned URL")
    parser.add_argument("filename", nargs="?", help="filename used to select the format")
    args = parser.parse_args(argv)
    validate_url(args.url)
    filename = args.filename or filename_from_url(args.url)
    return args.url, filename


def _process_document(url: str, extension: str, workdir: str) -> None:
    downloaded = os.path.join(workdir, "document")
    _download_with_curl(url, downloaded)
    if extension == ".zip":
        sys.stdout.write(list_zip_entries(downloaded))
    else:
        sys.stdout.write(parse_with_docling(downloaded, extension))


def main(argv: list[str] | None = None) -> int:
    try:
        url, filename = parse_args(sys.argv[1:] if argv is None else argv)
        extension = extension_for_filename(filename)
        with tempfile.TemporaryDirectory(prefix="parse-document-", dir="/tmp") as workdir:
            _process_document(url, extension, workdir)
    except ParseDocumentError as exc:
        print(f"parse-document: {exc}", file=sys.stderr)
        return EXIT_INVALID_INPUT if str(exc) in {
            "presigned URL must use HTTPS",
            "invalid presigned URL",
            "PARSE_DOCUMENT_ALLOWED_HOST is not configured",
            "presigned URL must not include userinfo",
            "presigned URL must not include a port",
            "presigned URL host is not allowed",
            "invalid arguments",
            "filename is invalid",
            "filename must be a basename",
            "unsupported file format",
        } else EXIT_RUNTIME
    except (OSError, KeyboardInterrupt, BrokenPipeError):
        print("parse-document: operation failed", file=sys.stderr)
        return EXIT_RUNTIME
    return 0


if __name__ == "__main__":
    sys.exit(main())
