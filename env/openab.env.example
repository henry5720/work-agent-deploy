# 這份是範本。正本 `env/openab.env` 不進 Git，mode 必須是 600 或 640。
#
# 這些 runtime secret 全部存在同一個 container 裡：Slack token 和公司 gateway key
# 都會被 OpenAB 傳給 agent process（見 config/openab.toml 的 inherit_env）。
# 這是明確接受的取捨 —— 沒有 broker，也沒有 Slack token 隔離層。邊界靠的是
# Slack allowlist、唯讀 snapshot 與 agent 的 permission 設定，不是 token 分離。

# Slack Bot User OAuth Token。Slack app 安裝到 workspace 後，
# 到 OAuth & Permissions 複製；必須以 xoxb- 開頭。
SLACK_BOT_TOKEN=xoxb-replace-me

# Slack App-Level Token，供 OpenAB 透過 Socket Mode 連線。
# 到 Basic Information > App-Level Tokens 建立，scope 選 connections:write；
# 必須以 xapp- 開頭。這不是 Signing Secret，也不是上面的 bot token。
SLACK_APP_TOKEN=xapp-replace-me

# Bug/需求總表網址中的 List ID（F 開頭）。
SLACK_LIST_ID=F0B9PSESQ2U

# Slack workspace/team ID（T 開頭），用來產生待辦列 deep link。
SLACK_TEAM_ID=T0B54FC26FR

# 公司 gateway，只提供 Responses API（不是 chat completions）。兩個地方會讀這兩個值：
# 1. OpenCode 的 provider `company`（`{env:...}`，見 config/opencode/opencode.json）。
# 2. `company-image`，生圖／改圖的唯一入口 —— Claude ACP rollback 也用它，所以
#    兩個 runtime 都必填，preflight 會擋。
# BASE_URL 是 gateway 提供 Responses API 的**前綴**，兩個消費者都在後面接
# `/responses`，所以填錯的症狀是推論回 HTTP 405（見
# docs/adr/0010-company-provider-uses-the-responses-api.md）。不要假設是 `/v1` ——
# 公司 gateway 的前綴不是。填之前確認 `<BASE_URL>/responses` 就是那台 gateway 的
# Responses endpoint。結尾不要帶斜線。
# 必須是 https：`company-image` 只在 localhost 才接受 http。
COMPANY_GATEWAY_BASE_URL=https://replace-me
COMPANY_GATEWAY_API_KEY=replace-me

# Cloudflare R2 credentials for OpenAB's incoming attachment filestore. Keep
# these values only in env/openab.env on the deployment host; preflight rejects
# empty or placeholder values.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 可選的 STT provider。不要假設上面的公司 gateway 支援 audio/transcriptions；先確認另一個
# OpenAI-compatible endpoint，兩個值都填好後才把兩份 config/openab*.toml 的
# [stt].enabled 改為 true。未設定（預設）時 bot 會拒絕 audio，不會嘗試轉送。
STT_BASE_URL=
STT_API_KEY=

# 遠端 bot 沒有 GitHub credential，只交付草稿與 handoff，不建立 issue。
WORK_HELPER_ISSUE_MODE=manual

# OpenAB log level。排障時可暫時改成 openab=debug。
RUST_LOG=openab=info
