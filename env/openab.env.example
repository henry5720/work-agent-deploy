# Slack Bot User OAuth Token。Slack app 安裝到 workspace 後，
# 到 OAuth & Permissions 複製；必須以 xoxb- 開頭。
SLACK_BOT_TOKEN=xoxb-replace-me

# Slack App-Level Token，供 OpenAB 透過 Socket Mode 連線。
# 到 Basic Information > App-Level Tokens 建立，scope 選 connections:write；
# 必須以 xapp- 開頭。這不是 Signing Secret，也不是上面的 bot token。
SLACK_APP_TOKEN=xapp-replace-me

# Bug/需求總表網址中的 List ID（F 開頭）。
SLACK_LIST_ID=F0B9PSESQ2U

# Slack workspace/team ID（T 開頭），用來產生待辦列 deep link。
SLACK_TEAM_ID=T0B54FC26FR

# 遠端 backlog agent 沒有 GitHub credential，只交付草稿，不建立 issue。
WORK_HELPER_ISSUE_MODE=manual

# OpenAB log level。排障時可暫時改成 openab=debug。
RUST_LOG=openab=info
